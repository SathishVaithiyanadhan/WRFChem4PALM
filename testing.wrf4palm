[case]
case_name = "testing",
max_pool = 4,
geostrophic = " ", ## calculate geostrophic wind using the variable pressure (option "p") or geopotential height  (option "z")

[domain]
palm_proj = "EPSG:25832",    # projection of PALM
centlat = 48.37641, #Bourges platz station location
centlon = 10.88836, 
# centlat = 48.36587,  #Königsplatz
# centlon = 10.89428, 
nx        = 100,                                  # number of grid points along x-axis
ny        = 100,                                  # number of grid points along y-axis
nz        = 50,                                  # number of grid points along z-axis
dx        = 10.0,                                 # number of grid points along x-axis
dy        = 10.0,                                 # number of grid points along y-axis
dz        = 10.0,                                 # number of grid points along z-axis
z_origin  = 508.0,                                # elevated mean grid position (elevated terrain)

[stretch]
dz_stretch_factor = 1.08,        # stretch factor for a vertically stretched grid
                                # set this to 1.0 if no streching required
dz_stretch_level = 400.0,      # Height level above which the grid is to be stretched vertically (in m)
dz_max = 50.0,                  # allowed maximum vertical grid spacing (in m)

[wrf]
wrf_path = "/home/vaithisa/WRF4PALM_v1.1.2/wrf_output/", #"/home/vaithisa/WRF4PALM_v1.1.2/wrf_output/",  "/mnt/d/WRF-Chem/"
wrf_output = "wrfout_d02_2024-08-*",   #"wrfout_d02_2025-02-*" "wrfout_d02_2024-08-*" "wrfout_d02_2022-04-*"

interp_mode = "linear",  #"nearest" "linear"

start_year = 2024,
start_month = 8,
start_day = 25,
start_hour = 00,

end_year = 2024,
end_month = 8,
end_day = 25,
end_hour = 23,

dynamic_ts = 3600.0,         # PALM dynamic driver update frequency

[soil]
# layers for soil temperature and moisture calculation
# this shall be changed depending on different cases
dz_soil = 0.01, 0.02, 0.04, 0.06, 0.14, 0.26, 0.54, 1.86,
msoil = 0.3, # dummy value in case soil moisture from WRF output is 0.0

[chemistry] 
# species = ["hno3","ho2","ho","no2","o3","no","nh3", "sulf", "RH", "RO2", "RCHO", "OCSV", "OCNV", "PM10","PM2_5_DRY"]   #all_species
 species = ["hno3","ho2","ho","no2","o3","no","nh3", "sulf", "RH", "RO2", "RCHO", "OCSV", "OCNV", "no2_traffic","no_traffic"]   #salsa+simple_tra
# species = ["hno3","RCHO","RH","ho2","no2","RO2","ho","o3","no", "no2_traffic","no_traffic"]   #simple_traffic
# species = ["hno3","RCHO","RH","ho2","no2","RO2","ho","o3","no"]   #simplec
# species = ["PM10","PM2_5_DRY"] #passive
# species = ["hno3","ho2","ho","no2","o3","no","nh3", "sulf", "RH", "RO2", "RCHO", "OCSV", "OCNV"]   #salsa+simple
# species = []
# chemical species to include from WRF-Chem - "PM10","PM2_5_DRY","hno3","ho2","ho","no2","o3","no","nh3","so2","co", "sulf", "RH","RO2","RCHO","OCSV", "OCNV"

[radiation]
# Radiation settings 
radiation_from_wrf = True,
radiation_smoothing_distance = 10000.0,  # Distance (in meters) around domain center to average radiation data

[aerosol]
# Aerosol processing settings
aerosol_wrfchem = True,                     # Enable aerosol processing
listspec = ["SO4", "OC", "BC", "SS", "NH", "NO", "DU"],  # Aerosol chemical components
nbin = [1, 7],                              # Number of bins in each subrange [bins in subrange 1, bins in subrange 2]
reglim = [3.9e-8, 5.0e-8, 2.5e-6],         # Bin limits (m) [3.9e-8, 5.0e-8, 2.5e-6]   [2.5E-9, 1.5E-8, 1.0E-6] [3.0e-9, 1.0e-8, 2.5e-6] [d_min, d_split, d_max] in meters
wrfchem_bin_limits = [3.9e-8, 1.56e-7, 6.25e-7, 2.5e-6, 1.0e-5],  # WRF-Chem bin limits
nf2a = 1.0,                                 # Soluble/insoluble fraction factor